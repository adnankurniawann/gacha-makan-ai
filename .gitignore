# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local

# personal documents
*.doc
*.docx
*.ppt
*.pptx
*.xls
*.xlsx
*.pdf
*.odt
*.ods
*.rtf

# hasil ingest OSM — bisa dibuat ulang kapan saja dengan
# `node scripts/ingest-osm.mjs`, dan ukurannya ikut jumlah tempat
/supabase/generated/

# data latih dan bundle sintetis — dibuat ulang oleh scripts/synthesize-spins.ts
# dan dari ekspor Supabase. ml/bandit.json yang dilatih dari data nyata
# memang di-commit supaya ikut ter-deploy.
/ml/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
